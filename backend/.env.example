# Token que debe enviar el ESP32 (query param ?token= o header X-Device-Token)
DEVICE_TOKEN=volobot-secret-2026

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Speech-to-text (faster-whisper), corre local en el contenedor
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# RAG ya armado: endpoint HTTP que recibe el texto transcrito y devuelve
# la respuesta dinámica. Ajustar al contrato real del RAG (ver rag_client.py).
RAG_API_URL=
RAG_API_KEY=
# Con RAG_API_URL vacío se usa el RAG simulado (app/mock_rag.py).
RAG_TIMEOUT_SECONDS=15

# Wake word / VAD. Con LOG_AUDIO_LEVELS=true se ve el nivel del mic cada 2 s para calibrar.
AUDIO_GAIN=1
VAD_MIN_RMS=500
LOG_AUDIO_LEVELS=false

# Servidor real (DarkoSync) por WebSocket. Con valor, este backend hace de intermediario entre el
# ESP32 y ese servidor (manda el audio grabado y muestra sus respuestas de texto, fichas y QR).
# Vacío = RAG simulado local. El audio de voz del servidor se ignora por ahora.
DARKOSYNC_WS_URL=wss://bot.darkosync.com/ws/iot?token=TOKEN_DEL_SERVIDOR&role=device
